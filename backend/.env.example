# =====================================================
# Deepfake Detector - Backend Configuration
# =====================================================
# Copy this file to .env and modify as needed

# API Configuration
# Set DEBUG=True for development, False for production
DEBUG=False
API_V1_PREFIX=/api/v1

# Model Configuration
MODEL_NAME=dima806/deepfake_vs_real_image_detection
MODEL_CACHE_DIR=./models/cache

# Database
# For production, consider using PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/deepfake_db
DATABASE_URL=sqlite:///./deepfake_detector.db

# Performance
# Set USE_GPU=True if you have CUDA/MPS available
USE_GPU=True
BATCH_SIZE=1
NUM_WORKERS=2

# CORS - Add your frontend URLs here
# JSON array format required
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:5173","http://localhost:80"]

# File Upload Limits (in bytes)
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=52428800

# Video Processing
VIDEO_FRAME_SAMPLE_RATE=30
VIDEO_MAX_FRAMES=100
VIDEO_PREDICTION_THRESHOLD=0.55

# Disagreement handling
DISAGREEMENT_MINORITY_VOTE_RATIO=0.75
DISAGREEMENT_NEAR_THRESHOLD_MARGIN=15.0
DISAGREEMENT_STRONG_OPPOSITION_THRESHOLD=90.0

# Security
# Set a strong token to enable and protect DELETE /api/v1/predictions/clear
ADMIN_CLEAR_TOKEN=
# Optional: additional admin tokens (JSON array)
ADMIN_CLEAR_TOKENS=[]
# Auth mode: token | jwt | hybrid
ADMIN_AUTH_MODE=token
# JWT settings (required for jwt/hybrid modes if using JWT auth)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ADMIN_JWT_ALLOWED_ROLES=["admin"]

# Rate limits (per client IP per endpoint)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IMAGE_PER_WINDOW=20
RATE_LIMIT_VIDEO_PER_WINDOW=5
# Limiter backend: memory | redis
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
